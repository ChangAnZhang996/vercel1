{
  "version": 2,
  "builds": [
    {
      "src": "api/server.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/server.py"
    }
  ],
  "functions": {
    "api/server.py": {
      "memory": 3008,
      "timeout": 180
    }
  }
}
